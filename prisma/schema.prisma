datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// -----------------------------------------------------------------------------
// Better Auth Core Models
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  workspaceMembers WorkspaceMember[]
  messagesSent     Message[]
  activities       ActivityLog[]
  projectMembers   ProjectMember[]
  approvalsCreated Approval[]        @relation("ApprovalSubmitter")
  approvalsDecided Approval[]        @relation("ApprovalDecider")
  filesUploaded    FileMetadata[]    @relation("FileUploader")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeWorkspaceId String?

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// -----------------------------------------------------------------------------
// Multi-Tenant Workspaces & Membership
// -----------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  DESIGNER
  DEVELOPER
  MEMBER
  CLIENT
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  plan         String   @default("Agency Pro Tier")
  customDomain String?
  agencyEmail  String?
  currency     String   @default("USD ($)")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       WorkspaceMember[]
  clients       Client[]
  projects      Project[]
  conversations Conversation[]
  files         FileMetadata[]
  approvals     Approval[]
  invoices      Invoice[]
  activities    ActivityLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

// -----------------------------------------------------------------------------
// Client Management
// -----------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  LEAD
  ARCHIVED
}

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  company     String
  email       String
  phone       String?
  avatar      String?
  status      ClientStatus @default(ACTIVE)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects      Project[]
  conversations Conversation[]
  invoices      Invoice[]
  approvals     Approval[]

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@map("clients")
}

// -----------------------------------------------------------------------------
// Projects & Assignments
// -----------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  category    String        @default("Web Design")
  description String        @db.Text
  budget      Decimal       @default(0) @db.Decimal(12, 2)
  status      ProjectStatus @default(IN_PROGRESS)
  progress    Int           @default(0)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  files         FileMetadata[]
  approvals     Approval[]
  invoices      Invoice[]
  conversations Conversation[]

  @@index([workspaceId])
  @@index([clientId])
  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  role       String   @default("Contributor")
  assignedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// Messaging & Communications
// -----------------------------------------------------------------------------

enum SenderType {
  AGENCY
  CLIENT
  SYSTEM
}

model Conversation {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String
  projectId     String?
  lastMessage   String?   @db.Text
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([workspaceId])
  @@index([clientId])
  @@map("conversations")
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  senderId       String?
  senderType     SenderType @default(AGENCY)
  senderName     String
  text           String     @db.Text
  read           Boolean    @default(false)
  createdAt      DateTime   @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("messages")
}

// -----------------------------------------------------------------------------
// Files & Deliverables Library
// -----------------------------------------------------------------------------

model FileMetadata {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  uploaderId  String?
  name        String
  size        Int      @default(0) // bytes
  mimeType    String   @default("application/octet-stream")
  category    String   @default("document")
  storageKey  String
  url         String?
  version     String   @default("v1.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader    User?     @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@map("files")
}

// -----------------------------------------------------------------------------
// Deliverable Approvals
// -----------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REVISION_REQUESTED
}

model Approval {
  id            String         @id @default(cuid())
  workspaceId   String
  projectId     String
  clientId      String?
  title         String
  description   String?        @db.Text
  version       String         @default("v1.0")
  status        ApprovalStatus @default(PENDING)
  feedback      String?        @db.Text
  dueDate       DateTime?
  submittedById String?
  decidedAt     DateTime?
  decidedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  submittedBy   User?     @relation("ApprovalSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  decidedBy     User?     @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@map("approvals")
}

// -----------------------------------------------------------------------------
// Invoicing & Financial Accounting
// -----------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id            String        @id @default(cuid())
  workspaceId   String
  clientId      String
  projectId     String?
  invoiceNumber String
  status        InvoiceStatus @default(PENDING)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  amount        Decimal       @default(0) @db.Decimal(12, 2)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([clientId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  rate        Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// -----------------------------------------------------------------------------
// Activity Audit Log
// -----------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  userName    String
  userAvatar  String?
  action      String
  target      String
  category    String   @default("general")
  projectId   String?
  projectName String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdAt])
  @@map("activity_logs")
}
